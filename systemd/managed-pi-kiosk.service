[Unit]
Description=Managed Pi HDMI kiosk
After=managed-pi-app.service systemd-user-sessions.service
Wants=managed-pi-app.service
Conflicts=getty@tty1.service
ConditionPathExists=/opt/managed-pi/current/deploy/run.sh

[Service]
Type=simple
User=managedpi
Group=managedpi
SupplementaryGroups=audio input render video
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=XDG_RUNTIME_DIR=/run/managed-pi-kiosk
RuntimeDirectory=managed-pi-kiosk
RuntimeDirectoryMode=0700
EnvironmentFile=-/etc/managed-pi/app.env
ExecStart=/usr/local/bin/managed-pi-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
