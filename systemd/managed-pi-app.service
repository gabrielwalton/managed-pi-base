[Unit]
Description=Managed Pi application
Wants=network-online.target
After=network-online.target managed-pi-agent.service
ConditionPathExists=/opt/managed-pi/current/deploy/run.sh

[Service]
Type=simple
User=managedpi
Group=managedpi
WorkingDirectory=/opt/managed-pi/current
EnvironmentFile=-/etc/managed-pi/app.env
EnvironmentFile=-/etc/managed-pi/agent.env
ExecStart=/bin/bash /opt/managed-pi/current/deploy/run.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/managed-pi/data

[Install]
WantedBy=multi-user.target
