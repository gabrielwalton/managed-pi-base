#!/bin/sh
set -eu

viewer_url="${MANAGED_PI_VIEWER_URL:-http://127.0.0.1:8080}"
kiosk_url_file="${MANAGED_PI_KIOSK_URL_FILE:-/opt/managed-pi/data/kiosk-url}"
kiosk_url="$viewer_url"

if [ -r "$kiosk_url_file" ]; then
  requested_url="$(/usr/bin/head -n 1 "$kiosk_url_file" | /usr/bin/tr -d '\r\n')"
  case "$requested_url" in
    http://*|https://*) kiosk_url="$requested_url" ;;
  esac
fi

while ! /usr/bin/curl --fail --silent --output /dev/null "$viewer_url/api/health"; do
  /usr/bin/sleep 2
done

audio_device="${MANAGED_PI_ALSA_OUTPUT_DEVICE:-}"
if [ -z "$audio_device" ]; then
  for eld_path in /proc/asound/card*/eld*; do
    [ -r "$eld_path" ] || continue
    if /usr/bin/grep -q '^monitor_present[[:space:]]*1' "$eld_path" && \
       /usr/bin/grep -q '^eld_valid[[:space:]]*1' "$eld_path"; then
      card_path="${eld_path%/*}"
      card_number="${card_path##*/card}"
      audio_device="plughw:${card_number},0"
      break
    fi
  done
fi

audio_option=""
if [ -n "$audio_device" ]; then
  audio_option="--alsa-output-device=$audio_device"
fi

exec /usr/bin/cage -s -- /usr/bin/chromium \
  --kiosk \
  --no-first-run \
  --disable-session-crashed-bubble \
  --disable-infobars \
  --autoplay-policy=no-user-gesture-required \
  --ozone-platform=wayland \
  --enable-features=UseOzonePlatform \
  $audio_option \
  "$kiosk_url"
