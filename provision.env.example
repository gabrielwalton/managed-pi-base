# Copy this file to managed-pi.env on the SD card's boot partition.
# It is moved to protected storage and deleted from the boot partition on first boot.
# "auto" appends the Pi's hardware serial suffix, so one image can be cloned.
MANAGED_PI_DEVICE_ID=auto
MANAGED_PI_DEVICE_ID_PREFIX=managed-pi
MANAGED_PI_DEVICE_NAME=Managed Pi
MANAGED_PI_MQTT_HOST=homeassistant.local
MANAGED_PI_MQTT_PORT=1883
MANAGED_PI_MQTT_USERNAME=replace_me
MANAGED_PI_MQTT_PASSWORD=replace_me
MANAGED_PI_APP_REPO=https://github.com/your-account/your-application.git
MANAGED_PI_REPO_BRANCH=main
MANAGED_PI_HEALTH_DELAY_SECONDS=5
MANAGED_PI_RELEASE_KEEP_COUNT=3
